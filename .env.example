NODE_ENV=development
DATABASE_URL=postgres://water:water@db:5432/water
PUBLIC_BASE_URL=http://localhost:5173
CONTACT_EMAIL=you@example.com          # sent in User-Agent to government sites and Nominatim

CPCB_URL=https://rtwqmsdb1.cpcb.gov.in/data/internet/layers/10/index.json
CPCB_INSECURE_TLS=false                # fallback only: set true to skip TLS verification for the CPCB host alone
RIVER_CRITERIA_CLASS=C

WQMIS_BASE=https://ejalshakti.gov.in/WQMIS
WQMIS_STATES=15
WQMIS_DISTRICTS=187
WQMIS_MIN_INTERVAL_MS=500

EMAIL_DRIVER=smtp
SMTP_URL=smtp://mailpit:1025           # Mailpit only; for real mail use a provider URL, e.g. smtps://user%40gmail.com:app-password@smtp.gmail.com:465
SMTP_SINK_URL=                         # optional: where reserved test domains (example.com, *.test) go, e.g. smtp://mailpit:1025
EMAIL_FROM="DownStream <alerts@localhost>"
MAX_EMAILS_PER_DAY=6

MOCK_MODE=true
MOCK_EMAIL=                            # optional: an address pre-subscribed at the simulation point
MOCK_LAT=16.18
MOCK_LNG=75.70
MOCK_INTERVAL_MIN=2
MOCK_INTERVAL_MAX=5

MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
